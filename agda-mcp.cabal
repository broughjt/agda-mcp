cabal-version: 3.0
name: agda-mcp
version: 0.1.0.0
synopsis: MCP server for interactive Agda development
description:
  An MCP server that lets coding agents use Agda interactively.
category: Development
license: BSD-3-Clause
author: Jackson Brough
maintainer: jacksontbrough@gmail.com
build-type: Simple

library
  hs-source-dirs: src
  exposed-modules:
    AgdaMCP
    AgdaMCP.Interaction
    AgdaMCP.Interaction.Context
    AgdaMCP.Interaction.ElaborateGive
    AgdaMCP.Interaction.Give
    AgdaMCP.Interaction.Goal
    AgdaMCP.Interaction.GoalCheck
    AgdaMCP.Interaction.GoalInfer
    AgdaMCP.Interaction.Internal
    AgdaMCP.Interaction.Intro
    AgdaMCP.Interaction.Load
    AgdaMCP.Interaction.Model
    AgdaMCP.Interaction.Refine
    AgdaMCP.Tools
    AgdaMCP.Tools.Internal
    AgdaMCP.Tools.Load
  build-depends:
      Agda == 2.8.*,
      aeson,
      atomic-write,
      base >= 4.18 && < 5,
      containers,
      mcp,
      mtl,
      parsec,
      stm,
      text
  default-language: GHC2021
  ghc-options:
      -Wall

executable agda-mcp
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
      agda-mcp,
      base >= 4.18 && < 5,
      mcp,
  default-language: GHC2021
  ghc-options:
      -Wall
      -Wcompat
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-home-modules
      -Wpartial-fields
      -Wredundant-constraints
