cabal-version: 3.0
name: agda-mcp
version: 0.1.0.0
synopsis: MCP server for interactive Agda development
description:
  An MCP server that lets coding agents use Agda interactively.
category: Development
license: BSD-3-Clause
author: Jackson Brough
maintainer: jacksontbrough@gmail.com
build-type: Simple

library interaction
  visibility: private
  hs-source-dirs: interaction
  exposed-modules:
    AgdaMCP.Interaction
    AgdaMCP.Interaction.Context
    AgdaMCP.Interaction.ElaborateGive
    AgdaMCP.Interaction.Give
    AgdaMCP.Interaction.Goal
    AgdaMCP.Interaction.GoalCheck
    AgdaMCP.Interaction.GoalInfer
    AgdaMCP.Interaction.Intro
    AgdaMCP.Interaction.Load
    AgdaMCP.Interaction.MakeCase
    AgdaMCP.Interaction.Metas
    AgdaMCP.Interaction.Refine
    AgdaMCP.Interaction.Testing
  other-modules:
    AgdaMCP.Interaction.Extract
    AgdaMCP.Interaction.Internal
    AgdaMCP.Interaction.Model
  build-depends:
      Agda == 2.8.*,
      base >= 4.18 && < 5,
      mtl,
      stm,
      text
  default-language: GHC2021
  ghc-options:
      -Wall

library
  hs-source-dirs: src
  exposed-modules:
    AgdaMCP
    AgdaMCP.Tools
    AgdaMCP.Tools.LoadId
    AgdaMCP.Tools.MCP
    AgdaMCP.Tools.Render
    AgdaMCP.Tools.State
    AgdaMCP.Tools.Load
    AgdaMCP.Tools.Give
    AgdaMCP.Tools.Goal
    AgdaMCP.Tools.Check
    AgdaMCP.Tools.CaseSplit
  build-depends:
      Agda == 2.8.*,
      agda-mcp:interaction,
      aeson,
      atomic-write,
      base >= 4.18 && < 5,
      containers,
      mcp,
      mtl,
      text
  default-language: GHC2021
  ghc-options:
      -Wall

test-suite agda-mcp-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
    Test.Corpus
    Test.Harness
    Test.Interaction
    Test.Model
    Test.Tool
    Test.Tool.Harness
    Test.Tool.Load
    Test.Tool.Scenario
  build-depends:
      Agda == 2.8.*,
      agda-mcp,
      agda-mcp:interaction,
      base >= 4.18 && < 5,
      directory,
      filepath,
      mtl,
      tasty,
      tasty-hunit,
      temporary,
      text,
      time
  default-language: GHC2021
  ghc-options:
      -Wall
      -threaded
      -rtsopts
      -with-rtsopts=-N

executable agda-mcp
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
      agda-mcp,
      base >= 4.18 && < 5,
      mcp,
  default-language: GHC2021
  ghc-options:
      -Wall
      -Wcompat
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-home-modules
      -Wpartial-fields
      -Wredundant-constraints
